{
  "name": "@nimadorostkar/human",
  "version": "1.0.0",
  "description": "Human by Nima Dorostkar: AI-powered 3D Face Detection & Rotation Tracking, Face Description & Recognition, Body Pose Tracking, 3D Hand & Finger Tracking, Iris Analysis, Age & Gender & Emotion Prediction, Gaze Tracking, Gesture Recognition",
  "author": "Nima Dorostkar <nimadorostkar97@gmail.com>",
  "contributors": [
    "Vladimir Mandic (original Human library, MIT)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/nimadorostkar/human",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimadorostkar/human.git"
  },
  "bugs": {
    "url": "https://github.com/nimadorostkar/human/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "main": "dist/human.node.js",
  "module": "dist/human.esm.js",
  "browser": "dist/human.esm.js",
  "types": "types/human.d.ts",
  "exports": {
    ".": {
      "types": "./types/human.d.ts",
      "node": "./dist/human.node.js",
      "import": "./dist/human.esm.js",
      "require": "./dist/human.node.js",
      "default": "./dist/human.esm.js"
    },
    "./dist/human": {
      "types": "./types/human.d.ts",
      "default": "./dist/human.js"
    },
    "./dist/human.js": {
      "types": "./types/human.d.ts",
      "default": "./dist/human.js"
    },
    "./dist/human.esm": {
      "types": "./types/human.d.ts",
      "default": "./dist/human.esm.js"
    },
    "./dist/human.esm.js": {
      "types": "./types/human.d.ts",
      "default": "./dist/human.esm.js"
    },
    "./dist/human.esm-nobundle": {
      "types": "./types/human.d.ts",
      "default": "./dist/human.esm-nobundle.js"
    },
    "./dist/human.esm-nobundle.js": {
      "types": "./types/human.d.ts",
      "default": "./dist/human.esm-nobundle.js"
    },
    "./dist/human.node": {
      "types": "./types/human.d.ts",
      "default": "./dist/human.node.js"
    },
    "./dist/human.node.js": {
      "types": "./types/human.d.ts",
      "default": "./dist/human.node.js"
    },
    "./dist/human.node-wasm": {
      "types": "./types/human.d.ts",
      "default": "./dist/human.node-wasm.js"
    },
    "./dist/human.node-wasm.js": {
      "types": "./types/human.d.ts",
      "default": "./dist/human.node-wasm.js"
    },
    "./dist/human.node-gpu": {
      "types": "./types/human.d.ts",
      "default": "./dist/human.node-gpu.js"
    },
    "./dist/human.node-gpu.js": {
      "types": "./types/human.d.ts",
      "default": "./dist/human.node-gpu.js"
    },
    "./dist/tfjs.esm": {
      "types": "./dist/tfjs.esm.d.ts",
      "default": "./dist/tfjs.esm.js"
    },
    "./dist/tfjs.esm.js": {
      "types": "./dist/tfjs.esm.d.ts",
      "default": "./dist/tfjs.esm.js"
    },
    "./models/*": "./models/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "types/human.d.ts",
    "types/tfjs-core.d.ts",
    "types/tfjs.esm.d.ts",
    "models/",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node --no-warnings demo/nodejs/node.js",
    "dev": "build --profile development",
    "clean": "build --profile clean",
    "build": "rimraf test/build.log && node build.js",
    "test": "node --no-warnings --unhandled-rejections=strict --trace-uncaught test/node.js",
    "lint": "eslint *.json *.js src demo test models",
    "serve": "build --profile serve",
    "compile": "build --profile compile",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "human",
    "human-library",
    "face-detection",
    "faceid",
    "face-geometry",
    "face-embedding",
    "face-recognition",
    "face-description",
    "face-matching",
    "body-tracking",
    "body-segmentation",
    "hand-tracking",
    "iris-tracking",
    "age-estimation",
    "emotion-detection",
    "gender-prediction",
    "gesture-recognition",
    "gaze-tracking",
    "age-gender",
    "tensorflowjs",
    "tfjs",
    "tensorflow"
  ],
  "devDependencies": {
    "@html-eslint/eslint-plugin": "^0.46.1",
    "@html-eslint/parser": "^0.46.0",
    "@microsoft/api-extractor": "^7.52.11",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tensorflow/tfjs-data": "^4.22.0",
    "@tensorflow/tfjs-layers": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@tensorflow/tfjs-node-gpu": "^4.22.0",
    "@types/emscripten": "^1.40.1",
    "@types/node": "^24.3.0",
    "@types/offscreencanvas": "^2019.7.3",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vladmandic/build": "^0.10.3",
    "@vladmandic/pilogger": "^0.5.2",
    "@vladmandic/tfjs": "github:vladmandic/tfjs",
    "canvas": "^3.2.0",
    "esbuild": "^0.25.9",
    "eslint": "8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "rimraf": "^6.0.1",
    "tslib": "^2.8.1",
    "typedoc": "0.28.11",
    "typescript": "5.9.2"
  }
}
